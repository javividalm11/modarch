# ── MODARCH WEB · Variables de entorno ──
# Copia este archivo como .env y completa los valores

# API key de Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de texto para el chatbot.
# Comprueba los disponibles para tu clave:
#   curl -H "x-goog-api-key: TU_CLAVE" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Modelo de audio nativo para el voicebot (Live API)
# Alternativas: gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voz del agente. Opciones: Kore, Puck, Charon, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Kore

# Puerto del servidor de API. Debe coincidir con el proxy de vite.config.js
PORT=8791

# Origen permitido en produccion (CORS). Vacio = mismo origen
ALLOWED_ORIGIN=

# Nota: los formularios ya no pasan por el servidor. Contacto y cotizador
# abren WhatsApp con el mensaje prellenado (company.whatsapp en
# shared/site-data.js), asi que no hay webhook de leads que configurar.
#
# En Cloudflare Pages, GEMINI_API_KEY y GEMINI_CHAT_MODEL se cargan como
# variables del proyecto (la clave como Secret), no desde este archivo.
